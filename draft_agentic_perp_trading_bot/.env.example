# src/crewai_app/crew.py: CrewModelSettings.from_environment() via
# _required_environment(); passed to build_bedrock_llm().
AWS_REGION_NAME=us-east-1

# src/crewai_app/crew.py: CrewModelSettings.from_environment(); Bedrock gate.
CREWAI_BEDROCK_ENABLED=false
# src/crewai_app/crew.py: _OWNER_MODEL_ENV and
# CrewModelSettings.from_environment(); one model ID per owner.
# Approved alternative multimodal LLMs for the four owner model variables, defined in
# src/crewai_app/domain/contracts/execution.py:
# deepseek.v3.2, zai.glm-4.7, zai.glm-4.7-flash, zai.glm-5,
# meta.llama4-maverick-17b-instruct-v1:0,
# meta.llama4-scout-17b-instruct-v1:0.
# src/crewai_app/crew.py: CrewModelSettings.from_environment(); shared
# Ministral reviewer model.
CREWAI_QWEN_OWNER_A_MODEL_ID=qwen.qwen3-vl-235b-a22b
CREWAI_QWEN_OWNER_B_MODEL_ID=qwen.qwen3-vl-235b-a22b
CREWAI_QWEN_OWNER_C_MODEL_ID=qwen.qwen3-vl-235b-a22b
CREWAI_QWEN_OWNER_D_MODEL_ID=qwen.qwen3-vl-235b-a22b
CREWAI_MINISTRAL_MODEL_ID=mistral.ministral-3-8b-instruct
# src/crewai_app/crew.py: CrewModelSettings.from_environment(); LLM timeout.
CREWAI_MODEL_TIMEOUT_SECONDS=15
# src/crewai_app/crew.py: CrewModelSettings.from_environment(); structured
# output repair retry limit.
CREWAI_STRUCTURED_OUTPUT_RETRIES=3

# src/crewai_app/main.py: run(); required only for the manual local
# preloaded-message harness, not production SQS ingestion or pytest.
CREWAI_LOCAL_RUN_INPUT_PATH=<path-to-signal-input.json>
# TelegramAgent signal ingestion is initiated from a local Telegram session and
# then hosted on AWS Lightsail. In current operation, this arrangement has not
# resulted in an account ban.
# Not currently read by src/crewai_app; reserved for the planned production
# Telegram/SQS ingestion adapter.
CREWAI_SQS_INPUT_QUEUE_URL=<sqs-input-queue-url>
# Not currently read by src/crewai_app; reserved for the planned execution
# dispatch adapter.
CREWAI_SQS_EXECUTION_QUEUE_URL=<sqs-execution-queue-url>
# Not currently read by src/crewai_app; reserved for the planned S3 serial-RAG
# adapter.
CREWAI_S3_RAG_BUCKET=<private-rag-bucket>
# Not currently read by src/crewai_app; reserved for the planned DynamoDB
# cursor repository.
CREWAI_DYNAMODB_CURSOR_TABLE=<cursor-table>
# Not currently read by src/crewai_app; reserved for the planned decision and
# performance repository.
CREWAI_DYNAMODB_DECISION_TABLE=<decision-table>
# Not currently read by src/crewai_app; reserved for the planned in-memory
# parent-tree/cache adapter.
CREWAI_ELASTICACHE_ENDPOINT=<elasticache-endpoint>

# src/crewai_app/crew.py: TradingSignalCrew.crew(); also read by
# src/crewai_app/main.py: run().
CREWAI_TRACING_ENABLED=false
# Not currently read by src/crewai_app; ExecutionMode() is constructed directly
# in src/crewai_app/main.py: run().
CREWAI_TESTNET_EXECUTION_ENABLED=false
# Not currently read by src/crewai_app; ExecutionMode() is constructed directly
# in src/crewai_app/main.py: run().
CREWAI_MAINNET_EXECUTION_ENABLED=false
